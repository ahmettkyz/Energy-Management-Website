# ==============================================================================
# Apollo Green Solutions - Environment Configuration Template
# Copy this file to .env.local for local development or set in your cloud provider
# ==============================================================================

# Next.js Public Configuration
NEXT_PUBLIC_SITE_URL=https://apollo-gs.com

# AI Chatbot Configuration (Optional)
# If provided, the Vercel AI SDK will use OpenAI's gpt-4o-mini for real-time AI responses.
# If omitted, Apollo's built-in intelligent streaming engine provides instantaneous responses without any key.
OPENAI_API_KEY=

# Node Environment
NODE_ENV=production
